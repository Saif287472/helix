# Copy this file to .env and fill in real values, then
# `docker compose up -d`. .env is gitignored - never commit real secrets
# here, and never edit docker-compose.yml itself to add them either, or
# it'll permanently diverge from the repo's copy and conflict on every
# future `git pull`.

HELIX_REMOTE_PORT=8080
HELIX_REMOTE_HOST=0.0.0.0
HELIX_REMOTE_DEV_MODE=0

# Required. Generate with: openssl rand -hex 32
HELIX_REMOTE_JWT_SECRET=change_me_to_a_random_32plus_byte_secret

# Required for the admin console (Helix Admin login token).
# Generate with: openssl rand -hex 24
HELIX_REMOTE_ADMIN_TOKEN=change_me_to_a_random_admin_token

HELIX_REMOTE_DB_PATH=/app/data/remote_backend.db
HELIX_REMOTE_ATTACHMENTS_DIR=/app/data/attachments
HELIX_REMOTE_LOG_FILE=/app/data/server.log

# Your server's public URL (the one behind your reverse proxy), e.g.
# https://your-domain.example - without it, admin-issued invite links come
# back without a scheme/host (just /join?invite=...) and are unusable once
# shared.
HELIX_REMOTE_PUBLIC_BASE_URL=https://your-domain.example

# TURN relay for WebRTC calls. Required for calls to connect when both
# parties are behind NAT, which is the normal case on mobile networks.
#
# docker-compose.yml runs coturn on this same host, so these point at
# your own domain. Both services read HELIX_REMOTE_TURN_SECRET from here
# - the backend signs credentials with it, coturn verifies them, and
# they will silently fail to agree if the two ever drift apart.
#
# List plain turn: first and turns: second; the client offers both, and
# turns: on 5349 only works once deploy/coturn/certbot-deploy-hook.sh has
# published a certificate. See deploy/coturn/README.md.
HELIX_REMOTE_TURN_URL=turn:your-domain.example:3478,turns:your-domain.example:5349

# Generate with: openssl rand -hex 32
HELIX_REMOTE_TURN_SECRET=change_me_to_a_random_turn_secret

# Used by the coturn container only.
# TURN_REALM must match the hostname in HELIX_REMOTE_TURN_URL.
TURN_REALM=your-domain.example
# Your VPS's public IPv4 address. Leave empty only if the public address
# is already bound directly to the interface and coturn detects it.
TURN_EXTERNAL_IP=

# Optional - push wake notifications are disabled without these.
# HELIX_REMOTE_FCM_PROJECT_ID=your-project-id
# HELIX_REMOTE_FCM_ACCESS_TOKEN=your-access-token

# Optional - required for real OTP delivery via BulkSMSBD. Without these,
# phone verification codes come back directly in the API response instead
# of being texted (fine for local dev, not for a real deployment).
# HELIX_REMOTE_SMS_API_KEY=your-bulksmsbd-api-key
# HELIX_REMOTE_SMS_SENDER_ID=your-approved-sender-id
