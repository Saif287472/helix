# Dart/Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
# pubspec.lock is committed on purpose - see
# docs/dependencies/WORKSPACE_LOCKFILE_POLICY.md. This is an application
# workspace, not a published library, so the lockfile is the reproducible
# dependency snapshot and CI enforces it with `pub get --enforce-lockfile`.
build/
*.iml
.idea/
.vscode/
coverage/

# Android
app/android/.gradle/
app/android/local.properties
app/android/GeneratedPluginRegistrant.java
app/android/key.properties
*.keystore
*.jks

# Flutter generated build config (per-platform, per-app)
**/ephemeral/

# Backend
backend/build/
backend/bin/*.exe

# Runtime data
attachments_storage/
backup_media_storage/
*.db
*.db-shm
*.db-wal

# OS
.DS_Store
Thumbs.db

# Deployment secrets - copy .env.example to .env and fill in real values
.env
