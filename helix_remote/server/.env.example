# Helix Remote v2 server configuration (copy to server/.env and fill in).
# Real environment variables override this file. Never commit server/.env.

# PostgreSQL 17. The role needs no superuser rights.
HELIX_DATABASE_URL=postgresql://helix:<password>@127.0.0.1:5432/helix?sslmode=disable

# Listen address. Caddy proxies to it, so keep it on loopback.
HELIX_HOST=127.0.0.1
HELIX_PORT=8080
HELIX_PUBLIC_BASE_URL=https://helix.agiletechbd.com

# JSON object of key id to base64url secret (at least 32 random bytes each).
# Add a new key and switch HELIX_JWT_ACTIVE_KID to rotate. Remove the old
# key after 60 days (the refresh-token lifetime).
HELIX_JWT_KEYS={"2026-10":"<base64url 32+ random bytes>"}
HELIX_JWT_ACTIVE_KID=2026-10

# single_host (one PC) or cluster (several nodes; needs S3 storage).
HELIX_TOPOLOGY=single_host

# true for Helix Global (phone sign-up), false for a personal server (invites).
HELIX_GLOBAL_MODE=true
HELIX_SERVER_NAME=Helix Global

# Object storage: local (a directory) or s3 (any S3-compatible store).
HELIX_BLOB_STORE=local
HELIX_BLOB_DIR=helix_blobs
# HELIX_S3_ENDPOINT=https://s3.example.com
# HELIX_S3_REGION=us-east-1
# HELIX_S3_BUCKET=helix
# HELIX_S3_ACCESS_KEY_ID=
# HELIX_S3_SECRET_ACCESS_KEY=
# HELIX_S3_PATH_STYLE=true

# identity module
# Key for stored phone hashes (base64url, 32+ random bytes). Keep it out of
# database backups; changing it orphans every stored phone hash.
HELIX_PHONE_PEPPER=<base64url 32+ random bytes>
HELIX_SMS_PROVIDER=bulksmsbd
HELIX_SMS_API_KEY=
HELIX_SMS_SENDER_ID=
# Defaults to the version of the built-in terms (HelixLegalDocuments).
# HELIX_TERMS_VERSION=
HELIX_OTP_RESEND_SECONDS=30

# Push wake-ups (data only, no content). none or fcm.
HELIX_PUSH_PROVIDER=fcm
HELIX_FCM_PROJECT_ID=
# Path to the Firebase service-account key file (or its JSON).
HELIX_FCM_SERVICE_ACCOUNT=

# Calls: coturn REST credentials (same secret as coturn's static-auth-secret).
HELIX_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
HELIX_TURN_SECRET=

HELIX_MAX_ATTACHMENT_BYTES=104857600

# Operator console: seeds the first admin password on a fresh server (12+
# characters; never replaces an existing one). Remove it after first start.
# HELIX_ADMIN_PASSWORD=

# Federation (accounts on other servers are uuid@domain; the domain is the
# authority of HELIX_PUBLIC_BASE_URL). Off by default; the operator console
# can switch it. HELIX_FEDERATION_ALLOW limits peers to these domains.
# HELIX_FEDERATION_ENABLED=false
# HELIX_FEDERATION_ALLOW=
# HELIX_FEDERATION_ALLOW_PRIVATE=false

# Android App Links: SHA-256 fingerprints (AB:CD:...) of the app's signing
# certificates, comma-separated.
# HELIX_ANDROID_CERT_SHA256=
HELIX_TRUSTED_PROXIES=127.0.0.1,::1
# HELIX_LOG_FILE=helix_server.log
