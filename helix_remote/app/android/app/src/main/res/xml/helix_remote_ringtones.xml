<?xml version="1.0" encoding="utf-8"?>
<!-- The one folder the com.helix.remote.ringtones provider may serve: the
     ringtone copies written by `core/sounds/orbit_ringtones.dart`.
     `external-files-path` is Context.getExternalFilesDir(null), which is what
     getExternalStorageDirectory() returns, and nothing else is exposed. -->
<paths>
    <external-files-path name="ringtones" path="ringtones/" />
</paths>
