# /etc/helix/backup.env: settings for the backup, health check and restore drill
# (systemd reads it; the scripts also read /opt/helix/.env, which the server
# ignores for these). No quotes needed. Lines starting with # are comments.

# Local backups (a dump per night, 14 kept) and blobs.
HELIX_BACKUP_DIR=/var/backups/helix
HELIX_BLOB_DIR=/var/lib/helix/blobs

# REQUIRED: where the encrypted copy goes. An rclone remote (run `rclone config`
# as the helix user... or point RCLONE_CONFIG at a file only helix can read), or
# a folder that is another machine's disk. A backup only on this VM is lost with
# it (deletion, ransomware, a provider problem).
#HELIX_OFFSITE=b2:my-bucket/helix
# The age PUBLIC key the copy is encrypted to. Keep the matching private key off
# the VM (a password manager and paper), never next to the backups.
#HELIX_AGE_RECIPIENT=age1...
#HELIX_OFFSITE_BLOBS=1
#HELIX_OFFSITE_KEEP=14

# Alerts that reach you when you are not at the VM:
# a heartbeat (healthchecks.io ping URL, pinged every healthy run) and a plain-text
# POST on every change (ntfy.sh/<long-random-topic>). Both URLs are secrets.
#HELIX_HEARTBEAT_URL=https://hc-ping.com/<uuid>
#HELIX_ALERT_URL=https://ntfy.sh/<topic>

# The private key file for restore drills from the .age copy (kept off the VM
# except while you run the drill by hand).
#HELIX_AGE_IDENTITY=/root/helix-age-key.txt
