*.key
*.crt
*.cer
*.csr
service-account*.json

# TLS material copied out of /etc/letsencrypt for the coturn container by
# deploy/coturn/certbot-deploy-hook.sh. Covered by *.pem above already;
# named explicitly so the directory itself is never added either.
turn-certs/
google-services.json
GoogleService-Info.plist
firebase_options.dart
secrets/
private/
local.properties
ADMIN_TOKEN.txt
**/ADMIN_TOKEN.txt
commands.txt

# Generated codebase extracts (large AI-readable dumps, regenerate with tool/extract_*.dart)
docs/codebase/

# Local databases and diagnostic exports
*.db
*.sqlite
*.sqlite3
diagnostics-*.json
audit-export-*.json

