{
  "version": 3,
  "notes": [
    "Workspace layout: apps/ holds the two-product apps; packages/local/ holds Local-classified",
    "packages; packages/shared/ and packages/remote/ are reserved for future packages.",
    "All paths are workspace-relative after package resolution by tool/check_boundaries.dart.",
    "helix_domain and helix_protocol are the innermost rings — nothing in those packages",
    "may import infrastructure, platform, transport, or app code.",
    "Phase 4 critical rule: apps/helix_remote must not import packages/local/**."
  ],
  "forbidden": [
    {
      "source": "apps/helix_remote/**",
      "imports": [
        "packages/local/**",
        "apps/helix_local/**"
      ],
      "reason": "Helix Remote must not import Local-classified packages or the Local app. Use packages/shared/** or packages/remote/** only."
    },
    {
      "source": "apps/helix_local/**",
      "imports": [
        "packages/remote/**"
      ],
      "reason": "Helix Local must not import Remote packages. Local must work without any Remote dependency."
    },
    {
      "source": "packages/shared/**",
      "imports": [
        "packages/local/**",
        "packages/remote/**",
        "apps/**"
      ],
      "reason": "Shared packages must be product-neutral and may not import from either product package tree or app code."
    },
    {
      "source": "packages/local/helix_local_domain/**",
      "imports": [
        "packages/local/helix_local_protocol/**",
        "packages/local/helix_local_crypto/**",
        "packages/local/helix_local_storage/**",
        "packages/local/helix_local_platform/**",
        "packages/local/helix_local_transport/**",
        "packages/local/helix_local_calls/**",
        "packages/local/helix_local_messaging/**",
        "packages/local/helix_local_transfer/**",
        "packages/local/helix_local_groups/**",
        "packages/local/helix_local_discovery/**",
        "apps/**"
      ],
      "reason": "Domain types and contracts must not depend on any other local package or app code."
    },
    {
      "source": "packages/local/helix_local_protocol/**",
      "imports": [
        "packages/local/helix_local_crypto/**",
        "packages/local/helix_local_storage/**",
        "packages/local/helix_local_platform/**",
        "packages/local/helix_local_transport/**",
        "packages/local/helix_local_calls/**",
        "packages/local/helix_local_messaging/**",
        "packages/local/helix_local_transfer/**",
        "packages/local/helix_local_groups/**",
        "packages/local/helix_local_discovery/**",
        "apps/**"
      ],
      "reason": "Protocol definitions must stay reusable outside transport, storage, and app code."
    },
    {
      "source": "packages/local/helix_local_crypto/**",
      "imports": [
        "packages/local/helix_local_storage/**",
        "packages/local/helix_local_platform/**",
        "packages/local/helix_local_transport/**",
        "packages/local/helix_local_calls/**",
        "packages/local/helix_local_messaging/**",
        "packages/local/helix_local_transfer/**",
        "packages/local/helix_local_groups/**",
        "packages/local/helix_local_discovery/**",
        "apps/**"
      ],
      "reason": "Crypto primitives must not depend on storage, platform, transport, or app code."
    },
    {
      "source": "packages/local/helix_local_storage/**",
      "imports": [
        "packages/local/helix_local_platform/**",
        "packages/local/helix_local_transport/**",
        "packages/local/helix_local_calls/**",
        "packages/local/helix_local_messaging/**",
        "packages/local/helix_local_transfer/**",
        "packages/local/helix_local_groups/**",
        "packages/local/helix_local_discovery/**",
        "apps/**"
      ],
      "reason": "Storage implementations must not depend on platform UI, transport, or app code."
    },
    {
      "source": "packages/local/helix_local_platform/**",
      "imports": [
        "packages/local/helix_local_transport/**",
        "packages/local/helix_local_calls/**",
        "packages/local/helix_local_messaging/**",
        "packages/local/helix_local_transfer/**",
        "packages/local/helix_local_groups/**",
        "packages/local/helix_local_discovery/**",
        "apps/**"
      ],
      "reason": "Platform wrappers must not depend on transport or higher-level feature packages."
    },
    {
      "source": "apps/helix_local/lib/ui/**",
      "imports": [
        "packages/local/helix_local_transport/**"
      ],
      "reason": "UI screens and widgets must not talk directly to transport internals."
    },
    {
      "source": "apps/helix_remote/lib/ui/**",
      "imports": [
        "packages/local/helix_local_transport/**"
      ],
      "reason": "UI screens and widgets must not talk directly to transport internals."
    }
  ]
}
