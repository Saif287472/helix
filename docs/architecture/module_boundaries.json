{
  "version": 2,
  "notes": [
    "Workspace layout: apps/ holds the two-product apps, packages/ holds shared packages.",
    "Paths use workspace-relative form after package resolution by tool/check_boundaries.dart.",
    "helix_domain and helix_protocol are the innermost rings — nothing in those packages",
    "may import infrastructure, platform, transport, or app code."
  ],
  "forbidden": [
    {
      "source": "packages/helix_domain/**",
      "imports": [
        "packages/helix_protocol/**",
        "packages/helix_crypto/**",
        "packages/helix_storage/**",
        "packages/helix_platform/**",
        "packages/helix_transport/**",
        "packages/helix_calls/**",
        "packages/helix_messaging/**",
        "packages/helix_transfer/**",
        "packages/helix_groups/**",
        "packages/helix_discovery/**",
        "apps/**"
      ],
      "reason": "Domain types and contracts must not depend on any other helix_* package or app code."
    },
    {
      "source": "packages/helix_protocol/**",
      "imports": [
        "packages/helix_crypto/**",
        "packages/helix_storage/**",
        "packages/helix_platform/**",
        "packages/helix_transport/**",
        "packages/helix_calls/**",
        "packages/helix_messaging/**",
        "packages/helix_transfer/**",
        "packages/helix_groups/**",
        "packages/helix_discovery/**",
        "apps/**"
      ],
      "reason": "Protocol definitions must stay reusable outside transport, storage, and app code."
    },
    {
      "source": "packages/helix_crypto/**",
      "imports": [
        "packages/helix_storage/**",
        "packages/helix_platform/**",
        "packages/helix_transport/**",
        "packages/helix_calls/**",
        "packages/helix_messaging/**",
        "packages/helix_transfer/**",
        "packages/helix_groups/**",
        "packages/helix_discovery/**",
        "apps/**"
      ],
      "reason": "Crypto primitives must not depend on storage, platform, transport, or app code."
    },
    {
      "source": "packages/helix_storage/**",
      "imports": [
        "packages/helix_platform/**",
        "packages/helix_transport/**",
        "packages/helix_calls/**",
        "packages/helix_messaging/**",
        "packages/helix_transfer/**",
        "packages/helix_groups/**",
        "packages/helix_discovery/**",
        "apps/**"
      ],
      "reason": "Storage implementations must not depend on platform UI, transport, or app code."
    },
    {
      "source": "packages/helix_platform/**",
      "imports": [
        "packages/helix_transport/**",
        "packages/helix_calls/**",
        "packages/helix_messaging/**",
        "packages/helix_transfer/**",
        "packages/helix_groups/**",
        "packages/helix_discovery/**",
        "apps/**"
      ],
      "reason": "Platform wrappers must not depend on transport or higher-level feature packages."
    },
    {
      "source": "apps/helix_local/lib/ui/**",
      "imports": [
        "packages/helix_transport/**"
      ],
      "reason": "UI screens and widgets must not talk directly to transport internals."
    },
    {
      "source": "apps/helix_remote/lib/ui/**",
      "imports": [
        "packages/helix_transport/**"
      ],
      "reason": "UI screens and widgets must not talk directly to transport internals."
    },
    {
      "source": "apps/helix_remote/**",
      "imports": [
        "apps/helix_local/**"
      ],
      "reason": "Helix Remote must not import Helix Local app code; use shared packages only."
    }
  ]
}
